{
  "name": "@deeds-evidence/processing-system",
  "version": "2.0.0",
  "description": "GPU-accelerated evidence processing with Go microservices and LangExtract",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "microservices/*"
  ],
  "scripts": {
    "launch": "zx launch.mjs",
    "launch:platform": "zx scripts/launch-legal-ai-platform.mjs",
    "check": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "check:auto:solve": "tsx autosolve-intelligent.ts",
    "check:auto:solve:iterative": "tsx autosolve-intelligent.ts",
    "capture:svelte-errors": "node scripts/capture-svelte-errors.mjs",
    "errors:patterns": "node scripts/extract-svelte-errors.mjs",
    "ci:svelte-gate": "node scripts/ci-svelte-gate.mjs",
    "solve:svelte:semantic": "node scripts/semantic-solve-svelte-errors.mjs",
    "solve:svelte:full": "npm run capture:svelte-errors && npm run errors:patterns && npm run solve:svelte:semantic",
    "solve:svelte:suggest": "npm run solve:svelte:full && npm run generate:suggestions && npm run apply:suggestions",
    "generate:suggestions": "node scripts/generate-suggestions.mjs",
    "generate:suggestions:concurrent": "node scripts/generate-suggestions-concurrent.mjs",
    "apply:suggestions": "node scripts/apply-suggestions.mjs",
    "solve:svelte:concurrent": "zx scripts/solve-svelte-concurrent.mjs",
    "cluster:orchestrate": "zx scripts/orchestrate-cluster.mjs",
    "dev": "cd sveltekit-frontend && npm run dev",
    "dev:fix": "powershell -ExecutionPolicy Bypass -Command \"& { ./scripts/fix-all-services.ps1 -AutoFix -StartServices; cd sveltekit-frontend; npm run dev }\"",
    "dev:fixed": "START-LEGAL-AI-FIXED.bat",
    "dev:full": "cd sveltekit-frontend && node scripts/start-coordinated-full-stack.mjs",
    "dev:full:batch": "START-LEGAL-AI.bat",
    "dev:complete": "START-COMPLETE-INTEGRATED-SYSTEM.bat",
    "test:integration": "node integration-test.mjs",
    "dev:postgres": "concurrently --restart-tries 3 --restart-after 4000 -n FRONTEND,PGRELAY,GOAPI \"npm run dev\" \"npm run pg:relay\" \"npm run go:api\"",
    "dev:dual": "concurrently --restart-tries 3 --restart-after 4000 -n FRONTEND,PROXY \"npm run dev\" \"node start-port-5180.cjs\"",
    "dev:proxy": "node start-port-5180.cjs",
    "start:proxy": "node start-port-5180.cjs",
    "start:dual": "concurrently --restart-tries 3 --restart-after 4000 -n FRONTEND,PROXY \"npm run dev\" \"node start-port-5180.cjs\"",
    "start:env": "node start-dual-ports-with-env.cjs",
    "test:env": "node test-env-setup.cjs",
    "node-api:dev": "cd microservices/node-api && npm run dev",
    "dev:full+nodeapi": "concurrently --restart-tries 3 --restart-after 4000 -n FRONTEND,CLUSTER,LB,MS,NODEAPI \"npm run dev\" \"npm run cluster:manager\" \"npm run lb:dev\" \"npm run microservices\" \"npm run node-api:dev\"",
    "build": "pnpm -r run build",
  "test": "vitest run --config vitest.config.ts",
  "test:watch": "vitest --config vitest.config.ts",
  "test:frontend": "vitest run --config vitest.config.ts --include sveltekit-frontend/src/lib/**/__tests__/*.test.ts",
    "lint": "pnpm -r run lint",
    "setup": "node scripts/setup-optimized.mjs",
    "start": "node scripts/start-all.mjs",
    "stop": "node scripts/stop-all.mjs",
    "health": "node scripts/health-check.mjs",
    "detect": "node scripts/detect-services.mjs",
    "gpu-test": "node scripts/gpu-diagnostics.mjs",
    "microservices": "node scripts/start-microservices.mjs",
    "pg:relay": "node src/lib/server/relays/pg-redis-relay.mjs",
    "go:api": "set PORT=8095 && go run simple-api-endpoints.go",
    "cluster:status": "node scripts/cluster-status.mjs",
    "ws:health": "powershell -NoProfile -Command \"Test-NetConnection -ComputerName localhost -Port 8080 | ConvertTo-Json\"",
    "bench:quic": "node scripts/quic-http-benchmark.mjs",
    "assets:validate": "node scripts/service-worker-asset-validator.mjs",
    "metrics:writer": "node scripts/metrics-writer.mjs",
    "demo": "node scripts/demo-optimized.mjs",
    "restoration:scan": "node scripts/restoration/cleanup-backups.mjs --dry-run",
    "restoration:apply": "node scripts/restoration/cleanup-backups.mjs --apply",
    "tasks:split": "node scripts/split-tasks.mjs",
    "tasks:merge": "node scripts/merge-tasks.mjs",
    "tasks:verify": "node scripts/verify-tasks-fragments.mjs",
  "tasks:regen": "node scripts/regenerate-tasks-monolith.mjs",
    "prepare-hooks": "git config core.hooksPath .githooks",
    "cluster:manager": "node scripts/run-cluster-manager.mjs",
    "cluster:manager:debug": "LOG_LEVEL=debug node node-cluster/cluster-manager.cjs",
    "cluster:single": "node -e \"process.env.LOG_LEVEL='debug'; process.env.MANAGER_PORT_AUTO='1'; process.env.MANAGER_PORT='3099'; require('./node-cluster/cluster-manager.cjs')\" -- --manager-port=3099 --legal-count=1 --ai-count=1 --vector-count=1 --database-count=1",
    "db:retry": "node scripts/db-retry-wrapper.mjs",
    "lb:postcheck": "node scripts/lb-test.mjs",
    "lb:dev": "node scripts/run-load-balancer.mjs",
    "lb:test": "node scripts/test-load-balancer.mjs",
    "lb:status": "curl -s http://localhost:8099/status",
    "lb:prom": "curl -s http://localhost:8099/prometheus",
    "auto:solve": "node scripts/auto-solve.mjs",
    "auto:solve:watch": "nodemon -e js,mjs,ts --watch scripts --exec 'node scripts/auto-solve.mjs'",
    "vector:scan": "node scripts/scan-and-embed.mjs",
    "vector:search": "node scripts/search.mjs",
    "logs:ws": "node scripts/log-ws-server.mjs",
    "cli:detect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cli-detect-update.ps1",
    "cli:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cli-detect-update.ps1 -AutoUpdate",
    "quic:server": "node scripts/quic-server.mjs",
    "redis:start": "redis-server --port 6379",
    "rabbitmq:start": "net start RabbitMQ || echo RabbitMQ already running",
    "minio:start": "minio server ./minio-data --console-address :9001",
    "validate:integration": "node scripts/validate-integration.mjs",
    "test:full-stack": "npm run validate:integration",
    "production:start": "PRODUCTION-ORCHESTRATOR.bat",
    "production:stop": "PRODUCTION-SHUTDOWN.bat",
    "production:status": "tsx production-orchestrator.ts status",
    "production:restart": "tsx production-orchestrator.ts restart",
    "production:monitor": "start http://localhost:8242",
    "production:test": "tsx integration-test-suite.ts run",
    "test:validate": "node validate-system.mjs",
    "test:complete": "RUN-TESTS.bat",
    "start:production": "node cuda-enhanced-orchestrator.mjs",
    "start:cuda": "node cuda-enhanced-orchestrator.mjs",
    "build:cuda": "BUILD-CUDA-GRPC-SYSTEM.bat",
    "start:cuda-system": "START-CUDA-GRPC-SYSTEM.bat",
    "check:models": "CHECK-MODELS.bat"
  },
  "dependencies": {
    "@ampproject/remapping": "^2.3.0",
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "@langchain/anthropic": "^0.2.0",
    "@langchain/community": "^0.2.0",
    "@langchain/core": "^0.2.0",
    "@langchain/google-genai": "^0.0.25",
    "@langchain/ollama": "^0.2.3",
    "@langchain/qdrant": "^0.1.3",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@msgpack/msgpack": "^3.1.2",
    "@opentelemetry/api": "^1.9.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.15.5",
    "@xenova/transformers": "^2.17.2",
    "amqplib": "^0.10.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "boxen": "^7.1.1",
    "bull": "^4.16.5",
    "bullmq": "^4.15.4",
    "cbor": "^10.0.10",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.8.3",
    "fastify": "^4.28.1",
    "fuse.js": "^7.1.0",
    "gel": "^2.1.1",
    "gradient-string": "^2.0.2",
    "helmet": "^8.1.0",
    "http-proxy": "^1.18.1",
    "inquirer": "^9.2.12",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.31",
    "lokijs": "^1.5.12",
    "lru-cache": "^11.1.0",
    "lucia": "^3.2.2",
    "mammoth": "^1.10.0",
    "melt": "^0.39.0",
    "minio": "^8.0.5",
    "ml-kmeans": "^6.0.0",
    "ml-matrix": "^6.12.1",
    "nanospinner": "^1.1.0",
    "neo4j-driver": "^5.28.1",
    "node-datachannel": "^0.7.0",
    "ora": "^7.0.1",
    "p-limit": "^4.0.0",
    "p-retry": "^6.1.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "pino": "^8.16.2",
    "postgres": "^3.4.7",
    "redis": "^5.8.2",
    "svelte": "^5.0.0",
    "sveltekit-superforms": "^2.27.1",
    "systeminformation": "^5.21.20",
    "tailwind-merge": "^3.3.1",
    "three": "^0.179.1",
    "xstate": "^5.20.2",
    "zod": "^4.0.17",
    "zx": "^7.2.3"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.47.1",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/kit": "^2.35.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@types/archiver": "^6.0.3",
    "@types/fabric": "^5.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minio": "^7.1.0",
    "@types/node": "^20.19.11",
    "@types/sharp": "^0.32.0",
    "@types/socket.io": "^3.0.1",
    "@types/tesseract.js": "^2.0.0",
    "@types/three": "^0.179.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.4",
    "nodemon": "^3.0.2",
    "svelte-check": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "resolutions": {
    "@typescript-eslint/utils": "^6.21.0",
    "magic-string": "^0.30.0",
    "vite": "^5.4.19",
    "rollup": "^4.0.0",
    "prettier": "^3.1.1",
    "svelte": "^5.0.0",
    "@sveltejs/kit": "^2.35.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4"
  },
  "packageManager": "pnpm@8.15.1"
}
