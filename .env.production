# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION - LEGAL AI PLATFORM
# =============================================================================
# This file contains production environment variables for the Legal AI Platform
# with YoRHa Interface System. Copy this to .env for production deployment.
#
# SECURITY WARNING: This file contains sensitive configuration. 
# - Never commit this file to version control
# - Use strong, unique values for all secrets
# - Regularly rotate passwords and API keys
# =============================================================================

NODE_ENV=production
PRODUCTION=true
BUILD_MODE=production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
DATABASE_URL="postgresql://legal_ai_admin:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/legal_ai_production"
PG_CONN_STRING="postgresql://legal_ai_admin:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/legal_ai_production"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_ai_production
POSTGRES_USER=legal_ai_admin
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_SSL=require

# pgvector Configuration
PGVECTOR_DIMENSIONS=768
VECTOR_SIMILARITY_THRESHOLD=0.7

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
NEO4J_DATABASE=legal_ai_graph

# Redis Configuration
REDIS_URL=redis://:CHANGE_THIS_STRONG_PASSWORD@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
REDIS_DB=0

# =============================================================================
# AUTHENTICATION & SESSION MANAGEMENT
# =============================================================================

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS_12345678
SESSION_COOKIE_NAME=yorha_session
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_ANOTHER_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS_87654321
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12

# Email Verification
EMAIL_VERIFICATION_SECRET=CHANGE_THIS_EMAIL_VERIFICATION_SECRET_KEY_123456789
EMAIL_VERIFICATION_EXPIRES=24h

# =============================================================================
# AI & ML SERVICES
# =============================================================================

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma3-legal:latest
OLLAMA_MODEL_LEGAL=gemma3-legal:latest
OLLAMA_MODEL_CHAT=gemma3-legal:latest
OLLAMA_MODEL_SUMMARY=gemma3-legal:latest
OLLAMA_MODEL_ANALYSIS=gemma3-legal:latest
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.1
OLLAMA_GPU_ENABLED=true
OLLAMA_GPU_LAYERS=35

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ONNX_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
PGVECTOR_DIMENSIONS=768

# NVIDIA GPU Configuration
CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=0
GPU_MEMORY_LIMIT=8GB
TENSOR_PARALLEL_SIZE=1

# Enhanced RAG Service
RAG_SERVICE_URL=http://localhost:8094
RAG_SERVICE_TIMEOUT=30000
RAG_BATCH_SIZE=32
RAG_MAX_CONTEXT_LENGTH=8192
RAG_STREAMING_ENABLED=true
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_RESULTS=10
RAG_CACHE_TTL=300

# Vector Search Configuration
VECTOR_SEARCH_LIMIT=10
VECTOR_SEARCH_THRESHOLD=0.7
SEMANTIC_CACHE_TTL=3600

# =============================================================================
# PRODUCTION SERVICE PORTS
# =============================================================================

# Core Infrastructure Services
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OLLAMA_PORT=11434

# Application Services
SVELTEKIT_PORT=443
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=8443

# Go Microservices (Production Ports)
GO_RAG_SERVICE_PORT=8094
GO_UPLOAD_SERVICE_PORT=8096
GO_GRPC_SERVICE_PORT=8084
GO_LOAD_BALANCER_PORT=8099
CLUSTER_MANAGER_PORT=8213
NODE_API_SERVICE_PORT=8095

# QUIC Protocol Services
QUIC_HTTP_PORT=8448
QUIC_QUIC_PORT=8444
QUIC_LEGAL_GATEWAY_PORT=8445

# Monitoring & Metrics
METRICS_PORT=9090
HEALTH_CHECK_PORT=8101
LOG_SERVER_PORT=8102

# =============================================================================
# MESSAGING & COMMUNICATION
# =============================================================================

# NATS Configuration
NATS_URL=ws://localhost:4222
NATS_USER=legal_ai_client
NATS_PASSWORD=CHANGE_THIS_NATS_PASSWORD
NATS_MAX_RECONNECT_ATTEMPTS=10
NATS_RECONNECT_TIME_WAIT=2000

# WebSocket Configuration
WS_PORT=8080
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=1000

# =============================================================================
# FILE STORAGE & PROCESSING
# =============================================================================

# MinIO Configuration (Production)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_THIS_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_KEY_WITH_STRONG_PASSWORD
MINIO_USE_SSL=false
MINIO_BUCKET=legal-documents
MINIO_BUCKET_UPLOADS=legal-documents
MINIO_BUCKET_PROCESSED=processed
MINIO_BUCKET_EVIDENCE=evidence
MINIO_MAX_FILE_SIZE=100MB

# Evidence Processing
EVIDENCE_STORAGE_PATH=/var/lib/legal-ai/evidence
EVIDENCE_PROCESSING_QUEUE=evidence_processing
EVIDENCE_METADATA_CACHE_TTL=3600
MAX_EVIDENCE_FILE_SIZE=104857600
SUPPORTED_EVIDENCE_FORMATS=pdf,doc,docx,txt,jpg,png,tiff

# File Processing
OCR_SERVICE_ENABLED=true
PDF_PROCESSING_ENABLED=true
IMAGE_PROCESSING_ENABLED=true
MAX_UPLOAD_SIZE=104857600

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# HTTPS Configuration
HTTPS_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/legal-ai.pem
SSL_KEY_PATH=/etc/ssl/private/legal-ai.key
SSL_CA_PATH=/etc/ssl/certs/ca-bundle.pem

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_CREDENTIALS=true
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_SKIP_SUCCESSFUL=false

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_URI=/api/csp-report

# API Security
API_KEY=CHANGE_THIS_TO_SECURE_API_KEY_WITH_GOOD_ENTROPY
SECURE_COOKIES=true

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/legal-ai/application.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# Performance Monitoring
PERFORMANCE_MONITORING=true
APM_SERVICE_NAME=legal-ai-platform
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30s

# Error Tracking
ERROR_TRACKING_ENABLED=true
SENTRY_DSN=CHANGE_THIS_TO_YOUR_SENTRY_DSN_URL

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_THIS_TO_YOUR_EMAIL
SMTP_PASSWORD=CHANGE_THIS_TO_YOUR_APP_PASSWORD

# Email Settings
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Legal AI Platform
EMAIL_REPLY_TO=support@yourdomain.com

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=443
PUBLIC_HOST=https://yourdomain.com
API_BASE_URL=https://yourdomain.com/api

# Frontend Build Configuration
VITE_NODE_ENV=production
VITE_PUBLIC_API_URL=https://yourdomain.com/api
VITE_PUBLIC_WS_URL=wss://yourdomain.com/ws
VITE_PUBLIC_APP_NAME=Legal AI Platform
VITE_PUBLIC_APP_VERSION=1.0.0
VITE_OLLAMA_URL=https://yourdomain.com/ollama

# Feature Flags
FEATURE_AI_ANALYSIS=true
FEATURE_DOCUMENT_OCR=true
FEATURE_VECTOR_SEARCH=true
FEATURE_GRAPH_ANALYSIS=true
FEATURE_REAL_TIME_CHAT=true
FEATURE_ADVANCED_REPORTS=true

# =============================================================================
# PRODUCTION BUILD SETTINGS
# =============================================================================

# Debug Settings (DISABLED IN PRODUCTION)
DEBUG=false
VITE_DEBUG=false
TYPESCRIPT_STRICT=true

# Development Tools (DISABLED IN PRODUCTION)
HOT_RELOAD=false
SOURCE_MAPS=false
MINIFY=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=legal-ai-backups
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_BACKUP_ENCRYPTION_KEY

# Maintenance Windows
MAINTENANCE_MODE=false
MAINTENANCE_START_TIME="02:00"
MAINTENANCE_END_TIME="04:00"

# =============================================================================
# LEGAL AI SPECIFIC CONFIGURATION
# =============================================================================

# Legal Analysis
LEGAL_CITATION_FORMAT=bluebook
LEGAL_JURISDICTION_DEFAULT=federal
CASE_SCORING_ENABLED=true
PRECEDENT_ANALYSIS_ENABLED=true

# Evidence Processing
EVIDENCE_HASH_VERIFICATION=true
CHAIN_OF_CUSTODY_TRACKING=true
EVIDENCE_ENCRYPTION=true

# YoRHa Interface Configuration
YORHA_THEME_ENABLED=true
YORHA_TERMINAL_ENABLED=true
YORHA_ANIMATIONS_ENABLED=true
YORHA_3D_INTERFACE=true
YORHA_HOLOGRAPHIC_EFFECTS=true

# =============================================================================
# CLUSTERING & SCALING
# =============================================================================

# Cluster Configuration
CLUSTER_ENABLED=true
CLUSTER_NODE_ID=node-1
CLUSTER_NODES=node-1,node-2,node-3
LOAD_BALANCER_ALGORITHM=round_robin

# Auto-Solver Configuration
AUTO_SOLVER_ENABLED=false
AUTO_SOLVER_MAX_WORKERS=4
AUTO_SOLVER_GPU_ENABLED=false

# Cluster Worker Configuration
CLUSTER_LEGAL_WORKERS=2
CLUSTER_AI_WORKERS=2
CLUSTER_VECTOR_WORKERS=2
CLUSTER_DATABASE_WORKERS=2
CLUSTER_LEGAL_BASE_PORT=8010
CLUSTER_AI_BASE_PORT=8020
CLUSTER_VECTOR_BASE_PORT=8030
CLUSTER_DATABASE_BASE_PORT=8040

# Scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_INSTANCES=2
MAX_INSTANCES=10
SCALE_UP_THRESHOLD=80
SCALE_DOWN_THRESHOLD=30

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=legal_documents

# Third-party Legal Databases
WESTLAW_API_KEY=CHANGE_THIS_TO_YOUR_WESTLAW_API_KEY
LEXIS_API_KEY=CHANGE_THIS_TO_YOUR_LEXIS_API_KEY
GOOGLE_SCHOLAR_ENABLED=true

# Court Filing Integration
ECOURT_INTEGRATION=false
PACER_INTEGRATION=false

# =============================================================================
# END OF CONFIGURATION
# =============================================================================

# PRODUCTION DEPLOYMENT CHECKLIST:
# □ 1. Replace ALL "CHANGE_THIS_*" values with actual secure credentials
# □ 2. Generate strong random passwords (use: openssl rand -base64 32)
# □ 3. Configure SSL certificates for HTTPS
# □ 4. Set up proper firewall rules
# □ 5. Configure backup strategies
# □ 6. Set up monitoring and alerting
# □ 7. Test all services in staging environment
# □ 8. Configure reverse proxy (nginx/apache)
# □ 9. Set up log rotation
# □ 10. Configure automated security updates