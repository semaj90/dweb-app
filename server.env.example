# Server-side environment example (DO NOT commit real secrets)
# Copy to `server.env` locally and populate with your real values. Add `server.env` to .gitignore.

# PostgreSQL
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/legal_ai_db
PG_CONN_STRING=postgresql://db_user:db_password@localhost:5432/legal_ai_db

# Redis
REDIS_URL=redis://:redis_password@localhost:6379

# MinIO (if used by backend)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Ollama / Local LLM credentials (if required)
# OLLAMA_API_KEY=your_ollama_api_key_here

# Session / JWT secrets (server-side only)
JWT_SECRET=super-secret-jwt-secret
SESSION_SECRET=base64-or-node-secret

# Sentry / Monitoring (optional)
SENTRY_DSN=

# Other internal endpoints
QDRANT_URL=http://localhost:6333
PGVECTOR_CONNECTION_STRING=

# Example: how to use in Go
# In your startup, read os.Getenv("DATABASE_URL") and connect using the value above.

# Example: SvelteKit server usage
# Access `process.env.DATABASE_URL` from +server.ts or endpoints; do not expose the value to the client.
