{
  "name": "legal-ai-mcp-server",
  "displayName": "Legal AI MCP Server",
  "description": "Legal AI MCP server with enhanced RAG, document processing, and agent orchestration",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "mcp",
    "legal-ai",
    "rag",
    "legal",
    "sveltekit",
    "typescript",
    "prosecutor",
    "evidence"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/package.json",
    "workspaceContains:**/mcp*.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcp.analyzeCurrentContext",
        "title": "🔍 Analyze Current Context",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.suggestBestPractices",
        "title": "✨ Suggest Best Practices",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.getContextAwareDocs",
        "title": "📚 Get Context-Aware Documentation",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.analyzeErrors",
        "title": "🐛 Analyze TypeScript Errors",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.startServer",
        "title": "🚀 Start MCP Server",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.stopServer",
        "title": "🛑 Stop MCP Server",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.analyzeFullStack",
        "title": "🔍 Analyze Full Tech Stack",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.runAgentOrchestrator",
        "title": "🤖 Run Agent Orchestrator",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.openRAGStudio",
        "title": "🎛️ Open EnhancedRAG Studio",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.generateBestPractices",
        "title": "📋 Generate Best Practices Report",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.uploadDocument",
        "title": "📄 Upload Document to Knowledge Base",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.crawlWebsite",
        "title": "🌐 Crawl Website for Knowledge Base",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.syncLibraries",
        "title": "🔄 Sync Library Metadata",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.viewAgentLogs",
        "title": "📝 View Agent Call Logs",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.searchLibraries",
        "title": "🔍 Search Libraries",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.createWorkflow",
        "title": "⚡ Create Multi-Agent Workflow",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.viewWorkflows",
        "title": "📊 View Active Workflows",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.recordFeedback",
        "title": "⭐ Record User Feedback",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.viewMetrics",
        "title": "📈 View Performance Metrics",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.getBenchmarks",
        "title": "🎯 Get Benchmark Results",
        "category": "Legal AI MCP"
      },
      {
        "command": "mcp.autoSolveErrors",
        "title": "🔧 AutoSolve TypeScript Errors",
        "category": "AutoSolve"
      },
      {
        "command": "mcp.runComprehensiveCheck",
        "title": "🧪 Run Comprehensive System Check",
        "category": "AutoSolve"
      },
      {
        "command": "mcp.optimizeComponents",
        "title": "⚡ Optimize Svelte Components",
        "category": "AutoSolve"
      },
      {
        "command": "mcp.enhancedRAGQuery",
        "title": "🤖 Enhanced RAG Query",
        "category": "AutoSolve"
      },
      {
        "command": "mcp.testAllAutoSolve",
        "title": "🚀 Test All AutoSolve Commands",
        "category": "AutoSolve"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .ts || resourceExtname == .js || resourceExtname == .svelte",
          "command": "mcp.analyzeCurrentContext",
          "group": "mcp@1"
        },
        {
          "when": "resourceExtname == .ts || resourceExtname == .js || resourceExtname == .svelte",
          "command": "mcp.getContextAwareDocs",
          "group": "mcp@2"
        }
      ],
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "mcp.analyzeCurrentContext",
          "group": "mcp@1"
        }
      ]
    },
    "statusBarItems": [
      {
        "id": "mcpStatus",
        "name": "MCP Context7 Status",
        "alignment": "right",
        "priority": 100
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "enhancedRAGServer",
        "label": "Enhanced RAG & Multi-Agent Server"
      }
    ],
    "configuration": {
      "title": "Legal AI MCP Server",
      "properties": {
        "legalAI.serverPort": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Legal AI MCP server"
        },
        "legalAI.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start MCP server when workspace opens"
        },
        "legalAI.contextDetection": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic context detection from errors and files"
        },
        "legalAI.suggestionConfidenceThreshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.1,
          "maximum": 1,
          "description": "Minimum confidence threshold for MCP suggestions"
        },
        "legalAI.maxSuggestions": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of MCP suggestions to show"
        },
        "legalAI.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Logging level for MCP extension"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  }
}
