# Public-facing example env for sveltekit-frontend (safe to commit)
# Include only non-sensitive values that can be exposed to client bundles.

NODE_ENV=development
PUBLIC_APP_NAME=Legal AI File Merge System
PUBLIC_APP_VERSION=1.0.0
PUBLIC_APP_DESCRIPTION=Native Windows Legal AI Document Management

# API URLs (frontend should talk to backend APIs, not directly to DB)
PUBLIC_API_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:5173/api
PUBLIC_GO_BACKEND_URL=http://localhost:8094

# Public services (non-sensitive endpoints)
PUBLIC_MINIO_ENDPOINT=http://localhost:9000
PUBLIC_MINIO_CONSOLE=http://localhost:9001
PUBLIC_QDRANT_URL=http://localhost:6333
PUBLIC_OLLAMA_URL=http://localhost:11434

# Feature flags and UI config
PUBLIC_ENABLE_VECTOR_SEARCH=true
PUBLIC_MAX_SEARCH_RESULTS=50
PUBLIC_THEME=light

# Note: do NOT place secrets (DATABASE_URL, PG_CONN_STRING, MINIO_SECRET_KEY, JWT_SECRET) here.
